{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true
  },
  "providers": {
    "openai": {
      "keys": [
        { "name": "openai-primary", "value": "env.OPENAI_API_KEY", "models": ["*"], "weight": 1.0 }
      ],
      "network_config": { "max_retries": 2, "retry_backoff_initial": 500, "retry_backoff_max": 4000 }
    },
    "anthropic": {
      "keys": [
        { "name": "anthropic-primary", "value": "env.ANTHROPIC_API_KEY", "models": ["*"], "weight": 1.0 }
      ],
      "network_config": { "max_retries": 2, "retry_backoff_initial": 500, "retry_backoff_max": 4000 }
    },
    "groq": {
      "keys": [
        { "name": "groq-primary", "value": "env.GROQ_API_KEY", "models": ["*"], "weight": 1.0 }
      ]
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-staleguard",
        "name": "StaleGuard verifier",
        "value": "sk-bf-staleguard-local",
        "description": "Scoped key for StaleGuard - only the models it needs, with a monthly budget",
        "is_active": true,
        "provider_configs": [
          { "provider": "openai", "weight": 1.0, "allowed_models": ["gpt-4o-mini", "gpt-4o"], "key_ids": ["*"] },
          { "provider": "anthropic", "weight": 0.0, "allowed_models": ["claude-3-5-haiku-latest"], "key_ids": ["*"] },
          { "provider": "groq", "weight": 0.0, "allowed_models": ["llama-3.3-70b-versatile"], "key_ids": ["*"] }
        ]
      }
    ],
    "budgets": [
      { "id": "budget-staleguard", "virtual_key_id": "vk-staleguard", "max_limit": 25.0, "reset_duration": "1M" }
    ]
  },
  "config_store": { "enabled": false }
}
