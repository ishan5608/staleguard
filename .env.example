# --- StaleGuard ---
# live = Tavily + Bifrost, offline = bundled snapshot (no keys), auto = live if TAVILY_API_KEY is set
STALEGUARD_MODE=auto
TAVILY_API_KEY=
BIFROST_URL=http://localhost:8080
# Optional: Bifrost virtual key (governance budgets / model allow-list). Sent as x-bf-vk.
BIFROST_VIRTUAL_KEY=
# Models are Bifrost "provider/model" names. Free-tier defaults: Gemini primary, Groq fallback.
EXTRACT_MODEL=gemini/gemini-3.5-flash-lite
JUDGE_MODEL=gemini/gemini-3.5-flash
LLM_FALLBACKS=gemini/gemini-3.5-flash,groq/openai/gpt-oss-120b
DEFAULT_KNOWLEDGE_DATE=2024-06

# --- Provider keys, read by Bifrost (never by StaleGuard) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional, needs prepaid API credit (not covered by a Claude Pro plan):
ANTHROPIC_API_KEY=
