# --- StaleGuard ---
# live = Tavily + Bifrost, offline = bundled snapshot (no keys), auto = live if TAVILY_API_KEY is set
STALEGUARD_MODE=auto
TAVILY_API_KEY=tvly-...
BIFROST_URL=http://localhost:8080
# Optional: Bifrost virtual key (governance budgets / model allow-list). Sent as x-bf-vk.
BIFROST_VIRTUAL_KEY=sk-bf-staleguard-local
EXTRACT_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=openai/gpt-4o
LLM_FALLBACKS=anthropic/claude-3-5-haiku-latest,groq/llama-3.3-70b-versatile
DEFAULT_KNOWLEDGE_DATE=2024-06

# --- Provider keys, read by Bifrost (never by StaleGuard) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
