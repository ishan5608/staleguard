{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true
  },
  "providers": {
    "gemini": {
      "keys": [
        {
          "name": "gemini",
          "value": "env.GEMINI_API_KEY",
          "models": [
            "gemini-3.5-flash-lite"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 4000
      }
    },
    "groq": {
      "keys": [
        {
          "name": "groq",
          "value": "env.GROQ_API_KEY",
          "models": [
            "openai/gpt-oss-120b"
          ],
          "weight": 1.0
        }
      ],
      "network_config": {
        "max_retries": 2,
        "retry_backoff_initial": 500,
        "retry_backoff_max": 4000
      }
    }
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "vk-staleguard",
        "name": "StaleGuard verifier",
        "value": "sk-bf-staleguard-local",
        "description": "Scoped key for StaleGuard - only the models it needs",
        "is_active": true,
        "provider_configs": [
          {
            "provider": "gemini",
            "weight": 1.0,
            "allowed_models": [
              "gemini-3.5-flash-lite"
            ],
            "key_ids": [
              "*"
            ]
          },
          {
            "provider": "groq",
            "weight": 1.0,
            "allowed_models": [
              "openai/gpt-oss-120b"
            ],
            "key_ids": [
              "*"
            ]
          }
        ]
      }
    ],
    "budgets": [
      {
        "id": "budget-staleguard",
        "virtual_key_id": "vk-staleguard",
        "max_limit": 25.0,
        "reset_duration": "1M"
      }
    ]
  },
  "config_store": {
    "enabled": false
  }
}
